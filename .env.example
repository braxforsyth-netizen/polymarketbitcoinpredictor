# Copy to .env (or export these). Everything is optional.

# Price feed: "coinbase" (works in the US) or "binance" (blocked for US IPs)
PRICE_SOURCE=coinbase

# Stream Chainlink BTC/USD (the price Polymarket settles on) via Polymarket's free real-time feed.
# Set to "off" to use only the exchange price.
SETTLEMENT_FEED=chainlink

# Claude AI briefings + `btcpredict ask`. Leave empty to run fully free (no AI layer).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Optional free CryptoPanic token (https://cryptopanic.com/developers/api/) for extra headlines
CRYPTOPANIC_TOKEN=

# Strategy knobs
MIN_EDGE=0.04            # minimum expected value per $1 staked (after fees) before suggesting a bet
KELLY_FRACTION=0.25      # quarter-Kelly
BANKROLL=100             # used only to display a suggested stake
MAX_STAKE_FRACTION=0.05  # never suggest more than 5% of bankroll on one window
TAKER_FEE_RATE=0.03      # fee per share = TAKER_FEE_RATE * min(p, 1-p). VERIFY against Polymarket's current fee schedule.
MIN_SECONDS_LEFT=45      # don't suggest bets in the final seconds (latency / settlement-source risk)
